{
  "name": "tauri-vite-tailwind-monorepo-template",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "Tauri v2 desktop application template with a pnpm monorepo, Turborepo, Vite, React, TypeScript, Tailwind CSS and Vitest",
  "keywords": [
    "tauri",
    "tauri-v2",
    "rust",
    "vite",
    "react",
    "typescript",
    "tailwindcss",
    "vitest",
    "monorepo",
    "pnpm",
    "turbo",
    "template",
    "boilerplate"
  ],
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=9.6.0"
  },
  "scripts": {
    "setup": "npx @pixpilot/scaffoldfy@latest --config ./setup/scaffoldfy.json",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter @app/desktop tauri dev",
    "dev:web": "pnpm --filter @app/desktop dev",
    "tauri": "pnpm --filter @app/desktop tauri",
    "bundle": "pnpm --filter @app/desktop tauri build",
    "gen:icons": "pnpm --filter @app/desktop tauri icon",
    "build": "turbo run build",
    "tsc:watch": "pnpm exec tsc --noEmit --watch --project tsconfig.watch.json",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache && pnpm lint:root",
    "lint:fix": "pnpm lint --fix && pnpm lint:root:fix",
    "lint:root": "eslint .github *.config.{js,cjs,mjs,ts} *.json README.md --cache --cache-location .cache/.eslintcache",
    "lint:root:fix": "pnpm lint:root --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "fix:all": "pnpm format:fix && pnpm lint:fix && pnpm typecheck",
    "postinstall": "pnpm lint:ws && node setup/guard.mjs warn",
    "test": "turbo run test",
    "test:ui": "vitest --ui",
    "typecheck": "turbo run typecheck",
    "rust:fmt": "pnpm --filter @app/desktop rust:fmt",
    "rust:fmt:fix": "pnpm --filter @app/desktop rust:fmt:fix",
    "rust:lint": "pnpm --filter @app/desktop rust:lint",
    "rust:test": "pnpm --filter @app/desktop rust:test",
    "clean:workspaces": "turbo run clean:all && git clean -xdf .cache .turbo",
    "clean:workspaces:install": "pnpm clean:workspaces && pnpm install",
    "deps:update": "npx taze -r -w && pnpm install",
    "deps:update:major": "npx taze major -r -w && pnpm install",
    "gen:package": "npx @pixpilot/scaffoldfy@latest --config ./generators/package/scaffoldfy.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@internal/prettier-config": "workspace:*",
    "@pixpilot/dev-config": "catalog:dev",
    "@pixpilot/workspace-package-generator": "^2.1.2",
    "@turbo/gen": "^2.11.2",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "eslint": "catalog:dev",
    "glob": "catalog:dev",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "catalog:dev",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "turbo": "^2.11.2",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
