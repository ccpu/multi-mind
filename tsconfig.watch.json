{
  "extends": "./tooling/typescript/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noEmit": false
  },
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/.cache/**",
    "**/dist/**",
    "**/src-tauri/target/**",
    "coverage",
    "**/*.js"
  ]
}
