{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own two windows may do. Both are local pages the app ships, so they get every command it has; an embedded chat site is covered by guest.json instead and gets one.",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "opener:default",
    "allow-app-info",
    "allow-open-window",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-settings-location",
    "allow-set-settings-location",
    "allow-reset-settings-location",
    "allow-get-guest-config",
    "allow-guest-sync",
    "allow-guest-set-visible",
    "allow-guest-navigate",
    "allow-guest-reload",
    "allow-guest-eval",
    "allow-guest-url",
    "allow-guest-cookies",
    "allow-guest-delete-cookies",
    "allow-guest-open-devtools",
    "allow-guest-open-popup",
    "allow-guest-popup-menu"
  ]
}
