{
  "name": "@app/desktop",
  "type": "module",
  "version": "1.8.0",
  "private": true,
  "description": "Multi Mind: the main window, its settings dialog, and the Rust backend in src-tauri/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:fmt:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "git clean -xdf .cache .turbo dist node_modules src-tauri/target",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "catalog:prod",
    "@dnd-kit/modifiers": "catalog:prod",
    "@dnd-kit/sortable": "catalog:prod",
    "@dnd-kit/utilities": "catalog:prod",
    "@internal/configs": "workspace:*",
    "@internal/multi-mind": "workspace:*",
    "@internal/tailwind": "workspace:*",
    "@internal/tauri-api": "workspace:*",
    "@internal/ui": "workspace:*",
    "@internal/utils": "workspace:*",
    "@pixpilot/shadcn": "catalog:prod",
    "@pixpilot/shadcn-ui": "catalog:prod",
    "@tauri-apps/api": "catalog:prod",
    "@tauri-apps/plugin-clipboard-manager": "catalog:prod",
    "@tauri-apps/plugin-dialog": "catalog:prod",
    "@tauri-apps/plugin-opener": "catalog:prod",
    "easymde": "catalog:prod",
    "lucide-react": "catalog:prod",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "react-icons": "catalog:prod",
    "split.js": "catalog:prod",
    "tailwindcss": "catalog:prod"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vite": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@tauri-apps/cli": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "eslint": "catalog:dev",
    "prettier": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
